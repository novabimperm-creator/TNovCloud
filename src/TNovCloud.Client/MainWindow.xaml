<Window x:Class="TNovCloud.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TNovCloud" Height="680" Width="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Closing="OnClosing">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="16,12">
            <TextBlock Text="TNovCloud" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
        </Border>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="Готово"/>
        </StatusBar>
        <Grid Margin="16">
            <Grid x:Name="LoginPanel" MaxWidth="420" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Вход на сервер" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Label Content="Адрес сервера"/>
                    <TextBox x:Name="ServerBox"/>
                    <Label Content="Логин"/>
                    <TextBox x:Name="LoginBox"/>
                    <Label Content="Пароль"/>
                    <PasswordBox x:Name="PasswordBox"/>
                    <Label Content="Буква диска"/>
                    <TextBox x:Name="DriveBox" MaxLength="1" Width="60" HorizontalAlignment="Left"/>
                    <Button Content="Войти" Width="120" HorizontalAlignment="Left" Click="OnLogin"/>
                </StackPanel>
            </Grid>
            <DockPanel x:Name="WorkPanel" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock x:Name="UserText" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DriveText" Margin="0,4,0,8"/>
                    <WrapPanel>
                        <Button Content="Открыть диск" Click="OnOpenDrive"/>
                        <Button Content="Синхронизировать" Click="OnSync"/>
                        <Button Content="Выйти" Click="OnLogout"/>
                    </WrapPanel>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#444"
                               Text="Меню Проводника (Windows 11): ПКМ по файлу на диске TNovCloud → «Показать дополнительные параметры» (или Shift+ПКМ) → пункты «TNovCloud — …». Если их нет — перезапустите клиент и проверьте букву диска в строке выше."/>
                </StackPanel>
                <GroupBox Header="Файл на диске" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="SelectedFileText" Text="Файл не выбран" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <WrapPanel>
                            <Button Content="Выбрать файл…" Click="OnPickFile"/>
                            <Button Content="Взять на редактирование" Click="OnCheckout"/>
                            <Button Content="Сохранить изменения" Click="OnCheckin"/>
                            <Button Content="Отменить изменения" Click="OnCancelCheckout"/>
                            <Button Content="На согласование" Click="OnApproveFile"/>
                            <Button Content="Свойства и версии" Click="OnProperties"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Задачи согласования">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Согласовать" Click="OnApproveTask"/>
                            <Button Content="Отклонить" Click="OnRejectTask"/>
                            <Button Content="Обновить список" Click="OnRefreshInbox"/>
                        </StackPanel>
                        <ListView x:Name="InboxList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Файл" DisplayMemberBinding="{Binding FileName}" Width="180"/>
                                    <GridViewColumn Header="Процесс" DisplayMemberBinding="{Binding Title}" Width="220"/>
                                    <GridViewColumn Header="Срок" DisplayMemberBinding="{Binding DueAt}" Width="160"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </GroupBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
