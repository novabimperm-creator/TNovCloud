<Window x:Class="TNovCloud.Client.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Свойства файла" Height="460" Width="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Восстановить версию" Click="OnRestore" Width="180"/>
            <Button Content="Закрыть" Click="OnClose" Width="100"/>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock x:Name="MetaText" Margin="0,0,0,12"/>
            <ListView x:Name="VersionList" Height="280">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Версия" DisplayMemberBinding="{Binding Version}" Width="70"/>
                        <GridViewColumn Header="Размер" DisplayMemberBinding="{Binding SizeBytes}" Width="90"/>
                        <GridViewColumn Header="Автор" DisplayMemberBinding="{Binding CreatedByName}" Width="140"/>
                        <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding CreatedAt}" Width="160"/>
                        <GridViewColumn Header="Комментарий" DisplayMemberBinding="{Binding Comment}" Width="140"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </DockPanel>
</Window>
